ANTHROPIC_API_KEY=
PROBE_MODEL_PLAN=
PROBE_MODEL_STEP=
PROBE_MODEL_JUDGE=
PROBE_MODEL_DISPROVE=
# real | record | replay | fake. No default on purpose (D9): a run refuses to start until this
# is set, so spending real API money is always a deliberate choice.
PROBE_LLM_MODE=
# Caps one run's own spend. Default 0.30 if left blank (D9).
PROBE_MAX_COST_USD=
# Caps everything a real/record run adds to the shared runs/spend_ledger.jsonl file across many
# runs. Only enforced when PROBE_SPEND_LEDGER (or --out's sibling ledger, via the CLI) is set.
# Default 8.00 if left blank.
PROBE_TOTAL_BUDGET_USD=
# Shared ledger file for the total-budget check above. The CLI does not set this by default; set
# it to enable the cross-run cap, e.g. runs/spend_ledger.jsonl.
PROBE_SPEND_LEDGER=
# fake/replay: path to the script (fake) or llm_record.jsonl (replay) to serve answers from.
# Overridden by --llm-source on the CLI.
PROBE_LLM_SOURCE=
